<Window x:Class="StrategyGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Strategy Game"
        Height="760"
        Width="1180"
        MinHeight="560"
        MinWidth="860"
        Background="#171A1F"
        KeyDown="MainWindow_OnKeyDown">
    <Grid Margin="16">
        <Border x:Name="StartScreenBorder"
                Background="#222834"
                BorderBrush="#384155"
                BorderThickness="1"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="460"
                Padding="28">
            <StackPanel>
                <TextBlock Text="Strategy Game"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />

                <TextBlock Margin="0,10,0,0"
                           Text="Start a new game"
                           FontSize="16"
                           Foreground="#C8D0E0"
                           HorizontalAlignment="Center" />

                <Border Margin="0,22,0,0"
                        Padding="18"
                        Background="#1B2029"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="Player name"
                                   Foreground="#8FA3BF" />
                        <TextBox x:Name="PlayerNameTextBox"
                                 Margin="0,8,0,0"
                                 Padding="10,8"
                                 Text="Player" />

                        <TextBlock Margin="0,16,0,0"
                                   Text="Player class"
                                   Foreground="#8FA3BF" />
                        <ComboBox x:Name="PlayerTypeComboBox"
                                  Margin="0,8,0,0"
                                  Padding="8"
                                  SelectedIndex="0" />

                        <TextBlock Margin="0,16,0,0"
                                   Text="Map size"
                                   Foreground="#8FA3BF" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#C8D0E0"
                                   Text="Loaded from file when available" />
                        <TextBlock x:Name="MapSourceTextBlock"
                                   Margin="0,6,0,0"
                                   Foreground="#8FA3BF"
                                   Text="maps/simple.txt" />
                    </StackPanel>
                </Border>

                <Button x:Name="StartGameButton"
                        Margin="0,22,0,0"
                        Padding="12,10"
                        Click="StartGameButton_OnClick"
                        Content="Start game" />

                <TextBlock x:Name="StartScreenErrorTextBlock"
                           Margin="0,12,0,0"
                           Foreground="#FF9CA8"
                           Text=""
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DockPanel x:Name="GamePanel"
                   LastChildFill="True"
                   Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Vertical"
                        Margin="0,0,0,12">
                <TextBlock Text="Strategy Game"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock x:Name="GameInfoTextBlock"
                           Margin="0,6,0,0"
                           Foreground="#C8D0E0"
                           Text="Game state is not initialized yet." />
            </StackPanel>

            <Border DockPanel.Dock="Bottom"
                    Margin="0,12,0,0"
                    Padding="14"
                    Background="#222834"
                    BorderBrush="#384155"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <StackPanel Margin="18,0">
                        <TextBlock Text="Wood"
                                   Foreground="#8FA3BF"
                                   FontSize="12" />
                        <TextBlock x:Name="WoodTextBlock"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Margin="18,0">
                        <TextBlock Text="Stone"
                                   Foreground="#8FA3BF"
                                   FontSize="12" />
                        <TextBlock x:Name="StoneTextBlock"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Margin="18,0">
                        <TextBlock Text="Gold"
                                   Foreground="#8FA3BF"
                                   FontSize="12" />
                        <TextBlock x:Name="GoldTextBlock"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Right"
                    Width="220"
                    Margin="12,0,0,0"
                    Padding="14"
                    Background="#222834"
                    BorderBrush="#384155"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Hero"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White" />

                    <Border Margin="0,10,0,0"
                            Padding="12"
                            Background="#1B2029"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock x:Name="HeroNameTextBlock"
                                       Text="Player"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock x:Name="HeroTypeTextBlock"
                                       Margin="0,6,0,0"
                                       Foreground="#C8D0E0"
                                       Text="Knight" />
                            <TextBlock x:Name="HeroHealthTextBlock"
                                       Margin="0,6,0,0"
                                       Foreground="#C8D0E0"
                                       Text="Health: 0" />
                            <TextBlock x:Name="HeroPositionTextBlock"
                                       Margin="0,6,0,0"
                                       Foreground="#C8D0E0"
                                       Text="Position: (0, 0)" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,8"
                               Text="Controls"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White" />

                    <Button Margin="0,0,0,8"
                            Padding="10,8"
                            IsEnabled="False"
                            Content="Hero" />
                    <Button Margin="0,0,0,8"
                            Padding="10,8"
                            IsEnabled="False"
                            Content="Inventory" />
                    <Button Padding="10,8"
                            IsEnabled="False"
                            Content="End day" />

                    <TextBlock Margin="0,18,0,0"
                               Text="Use WASD or arrow keys to move."
                               TextWrapping="Wrap"
                               Foreground="#8FA3BF" />
                </StackPanel>
            </Border>

            <Border Background="#222834"
                    BorderBrush="#384155"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="GameCanvas"
                            Background="#1B2029" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</Window>
